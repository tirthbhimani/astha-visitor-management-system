rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth()   { return request.auth != null; }
    function isAdmin()  { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"; }
    function isEditor() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "editor"]; }

    // Users collection
    match /users/{userId} {
      allow read:   if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Visitors collection
    match /visitors/{visitorId} {
      allow read:   if isAuth();
      allow create: if isEditor();
      allow update: if isEditor();
      allow delete: if isAdmin();
    }

    // Reminders
    match /reminders/{reminderId} {
      allow read:   if isAuth();
      allow write:  if isEditor();
      allow delete: if isAdmin();
    }
  }
}